                },
                "maturity": {
                    "viewName": "Maturity"
                },
                "settings": {
                    "viewName": "Settings"
                },
                "monthEnd": {
                    "viewName": "MonthEnd"
                },
                "maturityHistory": {
                    "viewName": "MaturityHistory"
                }
            }
        }
