{
    "_version": "1.7.0",
    "sap.app": {
        "id": "com.infocus.zfifixeddepositZFI_FIXED_DEPOSIT",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "1.0.0"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "sourceTemplate": {
            "id": "servicecatalog.connectivityComponent",
            "version": "0.0.0"
        },
        "dataSources": {
            "ZFI_FIXED_DEPOSIT_SRV": {
                "uri": "/sap/opu/odata/sap/ZFI_FIXED_DEPOSIT_SRV/",
